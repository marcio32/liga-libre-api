@{
    ViewData["Title"] = "Liga Libre - Inicio";
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<div class="hero-section">
    <div class="container">
        <h1><i class="fas fa-futbol"></i> Liga Libre</h1>
        <p>Sistema completo de gestión para tu liga de fútbol</p>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h3 class="feature-title">Clubes</h3>
                <p class="feature-description">
                    Gestiona todos los clubes de la liga con información detallada de estadios, capacidad y socios.
                </p>
                <span class="stats-badge"><i class="fas fa-database"></i> CRUD Completo</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-users"></i>
                </div>
                <h3 class="feature-title">Jugadores</h3>
                <p class="feature-description">
                    Administra jugadores con estadísticas completas: goles, asistencias, tarjetas y más.
                </p>
                <span class="stats-badge"><i class="fas fa-chart-line"></i> Estadísticas</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-user-tie"></i>
                </div>
                <h3 class="feature-title">Árbitros</h3>
                <p class="feature-description">
                    Control de árbitros con categorías, licencias y asignación a partidos.
                </p>
                <span class="stats-badge"><i class="fas fa-id-card"></i> Licencias</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <h3 class="feature-title">Partidos</h3>
                <p class="feature-description">
                    Programa y gestiona partidos con resultados, estadios y estados en tiempo real.
                </p>
                <span class="stats-badge"><i class="fas fa-clock"></i> En Vivo</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-trophy"></i>
                </div>
                <h3 class="feature-title">Estadísticas</h3>
                <p class="feature-description">
                    Consulta estadísticas generales de la liga, goleadores y clasificaciones.
                </p>
                <span class="stats-badge"><i class="fas fa-medal"></i> Rankings</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-lock"></i>
                </div>
                <h3 class="feature-title">Seguridad</h3>
                <p class="feature-description">
                    Sistema de autenticación JWT con roles y permisos para proteger la información.
                </p>
                <span class="stats-badge"><i class="fas fa-shield-alt"></i> JWT Auth</span>
            </div>
        </div>
    </div>
</div>

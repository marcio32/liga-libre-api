@{
    ViewData["Title"] = "Clubes";
}

<link rel="stylesheet" href="~/css/clubs.css" asp-append-version="true" />

<div class="club-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2><i class="fas fa-shield-alt"></i> Gestión de Clubes</h2>
            <p class="mb-0">Administra todos los clubes de la liga</p>
        </div>
        <button class="btn btn-lg" style="background: white; color: #29b6f6; font-weight: 700; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.3); border-radius: 30px; padding: 12px 30px; transition: all 0.3s ease;" onmouseover="this.style.transform='scale(1.05)'; this.style.boxShadow='0 6px 20px rgba(0,0,0,0.4)'" onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.3)'" data-bs-toggle="modal" data-bs-target="#clubModal" onclick="openCreateModal()">
            <i class="fas fa-plus-circle"></i> Nuevo Club
        </button>
    </div>
</div>

<div id="clubsList" class="row"></div>

<!-- Modal Crear/Editar -->
<div class="modal fade" id="clubModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Nuevo Club</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="clubForm">
                    <input type="hidden" id="clubId">
                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-shield-alt"></i> Nombre</label>
                        <input type="text" class="form-control" id="name">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-city"></i> Ciudad</label>
                        <input type="text" class="form-control" id="city">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-envelope"></i> Email</label>
                        <input type="email" class="form-control" id="email">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-phone"></i> Teléfono</label>
                        <input type="text" class="form-control" id="phone">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-map-marker-alt"></i> Dirección</label>
                        <input type="text" class="form-control" id="address">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-stadium"></i> Estadio</label>
                        <input type="text" class="form-control" id="stadiumName">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-users"></i> Número de Socios</label>
                        <input type="number" class="form-control" id="numberOfPartners">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-gradient" onclick="saveClub()">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Confirmar Eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar este club?</p>
                <p class="text-muted">Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/clubs.js"></script>
}
